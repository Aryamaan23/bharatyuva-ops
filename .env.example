# ---------------------------------------------------------------------------
# Bharat Yuva Platform: environment variables
# Copy to .env.local for local development. On Vercel, set these per environment
# (Preview = staging Supabase project, Production = production project).
# Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL of the app (no trailing slash). Used in emails and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Local values come from `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for Storage signed URLs and Auth admin calls. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# App connection. On Vercel use the Supavisor *transaction* pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations need a session/direct connection (port 5432 / session pooler).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Secrets (generate each with: openssl rand -base64 48) ---------------------
# Bearer token Vercel Cron and pg_cron send to /api/cron/*.
CRON_SECRET=
# Salt for hashing IPs/emails stored for audit and deletion proofs.
HASH_SALT=
# HMAC key for guardian, deletion and QR tokens.
TOKEN_SIGNING_SECRET=

# Comma-separated emails that become owners on first sign-in.
OWNER_EMAILS=

# --- Messaging -----------------------------------------------------------------
# log      = write to the outbox only, send nothing
# redirect = send everything to TEST_INBOX (real recipient shown in the subject)
# live     = send to real recipients. ONLY honoured when VERCEL_ENV=production;
#            elsewhere it is downgraded to redirect (except local SMTP capture).
MESSAGE_MODE=live
# smtp (local Mailpit at 127.0.0.1:54325, view at http://127.0.0.1:54324) or resend
EMAIL_TRANSPORT=smtp
TEST_INBOX=
EMAIL_FROM=Bharat Yuva <hello@localhost>
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Resend free plan allows 100/day; the outbox spills over to the next day beyond this.
RESEND_DAILY_CAP=100
# Resend → Webhooks: endpoint <APP_URL>/api/webhooks/resend, events delivered/bounced/complained.
RESEND_WEBHOOK_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# --- Gmail (partner outreach from each staff member's own mailbox) -------------
# Google Cloud OAuth client (Web application). Redirect URI: <APP_URL>/api/gmail/callback
# Scopes requested: gmail.send, gmail.readonly, openid, email (see README for why).
# Without these, development uses a local stand-in that delivers to Mailpit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32   (encrypts stored refresh tokens; required with GOOGLE_CLIENT_ID)
GMAIL_TOKEN_KEY=

# --- Cloudflare Turnstile ------------------------------------------------------
# These are Cloudflare's documented always-pass TEST keys. Replace in staging/production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Monitoring ----------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- AI: drafting and summaries only; a person approves everything -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Feature flags -------------------------------------------------------------
FEATURE_WHATSAPP=false
# console (log only) | meta (WhatsApp Business Cloud API). Non-production always uses console.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook: GET verify token you choose; POST requests are checked against the app secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Show the Hindi language switch in production (set true once a native speaker has reviewed
# src/i18n/dictionaries/hi.ts and its `reviewed` flag is true).
NEXT_PUBLIC_HINDI_ENABLED=false
