# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# never commit real partner/applicant data
*.xlsx
*.xls
*.csv
!tests/fixtures/**/*.csv
backups/

# env: keep the documented template
!.env.example

# supabase local
supabase/.temp
supabase/.branches

# playwright
/playwright-report/
/test-results/
/playwright/.cache/

# sentry
.env.sentry-build-plugin
